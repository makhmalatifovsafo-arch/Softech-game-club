{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "redirects": [
    { "source": "/site", "destination": "/site/", "permanent": true },
    { "source": "/site/help", "destination": "/site/help/", "permanent": true },
    { "source": "/site/help/:topic", "destination": "/site/help/:topic/", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=:path*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/mobile",
      "destination": "/mobile/index.html"
    },
    {
      "source": "/mobile/",
      "destination": "/mobile/index.html"
    },
    {
      "source": "/login",
      "destination": "/views/login.html"
    },
    {
      "source": "/site/",
      "destination": "/site/index.html"
    },
    {
      "source": "/site/help/",
      "destination": "/site/help/index.html"
    },
    {
      "source": "/site/help/:topic/",
      "destination": "/site/help/:topic/index.html"
    }
  ]
}
