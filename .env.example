# Copy to .env in the repository root. Never commit real secrets.
# Initial credentials are used only when creating a NEW local admin database.
SUPERADMIN_INITIAL_PASSWORD=
# Required four-digit PIN for the first local database initialization.
SUPERADMIN_INITIAL_PIN=
# Generate each value separately: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SUPERADMIN_JWT_SECRET=
REFRESH_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Telegram webhook verification. Use the same random value when running telegram-webhook.mjs --configure.
TELEGRAM_WEBHOOK_SECRET=
# Server cloud endpoint; optional for the default hosted cloud.
SOFTECH_CLOUD_URL=https://softech-game-club.vercel.app
# If set, this signing key MUST match on cloud and every club server.
SOFTECH_CLOUD_KEY=
