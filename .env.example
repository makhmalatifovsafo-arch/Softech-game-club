# SOFTECH GAME CLUB — bitta kompyuterda lokal sinov
# Fayl: C:/Users/user/Documents/GitHub/Softech-game-club/.env
# Qiymatlarni = dan keyin kiriting. Maxsus belgili qiymatlarni "..." ichiga yozing.
# Bu fayl GitHubga yuborilmaydi. Chatga ham nusxalamang.
# Bu MARKAZIY ADMIN / TEST sozlamalari; faylni game club kompyuterlariga tarqatmang.
# Client uchun serverUrl alohida config.json da belgilanadi.

# 1. LOKAL SUPER ADMIN (faqat yangi baza uchun; login: admin)
# Kamida 12 belgili parol.
SUPERADMIN_INITIAL_PASSWORD=
# Aynan 4 ta raqam. Masalan ko'rsatilmaydi: o'zingiz tanlang.
SUPERADMIN_INITIAL_PIN=

# 2. KIRISH TOKENLARI — ikkita alohida maxfiy qiymat, har biri kamida 32 bayt
# Har bir qiymat uchun terminalda alohida bajaring:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SUPERADMIN_JWT_SECRET=
REFRESH_SECRET=

# 3. TELEGRAM — BotFather bergan token va xabar oluvchi admin chat ID
# Avval bot bilan Telegramda /start orqali suhbatni boshlang.
# Admin chat ID raqam bo'ladi; @username emas.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Webhook uchun alohida random secret: yuqoridagi node buyrug'i bilan yarating.
# Vercel va webhookni sozlashdagi qiymat aynan bir xil bo'lishi kerak.
TELEGRAM_WEBHOOK_SECRET=

# 4. SERVERNING MARKAZIY ADMINGA ULANISHI
# Hozir bitta kompyuterdagi lokal super adminni sinaymiz:
SOFTECH_CLOUD_URL=http://127.0.0.1:7000
# Keyin jonli bulut sinovi uchun yuqoridagi qiymatni quyidagiga almashtirish mumkin:
# https://softech-game-club.vercel.app
# PORT ni bu umumiy faylga yozmang: cloud 7000, server 5000 portda ishlaydi.

# 5. LITSENZIYA IMZOSI
# Maxsus kalit ishlatilsa, cloud va serverdagi qiymat bir xil bo'lishi shart.
# Mavjud jonli tizimda kalit bor bo'lsa, o'shani ishlating; o'zboshimchalik bilan yangilamang.
# Bo'sh qoldirilsa, hozirgi kodning moslik kaliti ishlatiladi.
SOFTECH_CLOUD_KEY=

# 6. SUPABASE — Verceldagi jonli super admin uchun
# Lokal SQLite sinovida bu uchalasini bo'sh qoldirish mumkin.
SUPABASE_URL=
# Faqat markaziy admin uchun! Game club yoki clientga bermang.
SUPABASE_SERVICE_ROLE_KEY=
# Serverning ixtiyoriy Supabase Realtime ulanishi uchun public anon key.
SUPABASE_ANON_KEY=

# 7. IXTIYORIY YANGILANISH MANZILI
# Bo'sh bo'lsa, loyihaning GitHub Releases manzili ishlatiladi.
UPDATE_MANIFEST_URL=

# Vercel bu lokal faylni avtomatik o'qimaydi.
# Jonli bulut sozlamalari o'sha loyihaning Environment Variables bo'limiga kiritiladi.
# Lokal sinov vaqti mavjud Telegram webhookni boshqa manzilga almashtirmang.
