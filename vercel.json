{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=:path*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/mobile",
      "destination": "/mobile/index.html"
    },
    {
      "source": "/mobile/",
      "destination": "/mobile/index.html"
    },
    {
      "source": "/login",
      "destination": "/views/login.html"
    }
  ]
}
