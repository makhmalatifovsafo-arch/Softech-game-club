<Window x:Class="ClientSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Softech Game Club - Kiosk Client O'rnatish Dasturi" 
        Height="620" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B0E14"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="NeonButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6EE7B7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#10B981"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#111827" CornerRadius="12" Padding="20,16" BorderBrush="#1F2937" BorderThickness="1" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SOFTECH GAME CLUB PRO" FontSize="20" FontWeight="Bold" Foreground="#34D399"/>
                    <TextBlock Text="Mijoz Kompyuterlari uchun Kiosk Qulflash Dasturi O'rnatuvchisi" FontSize="13" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#064E3B" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="CLIENT v1.0" FontWeight="Bold" FontSize="11" Foreground="#6EE7B7"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Form -->
        <Border Grid.Row="1" Background="#111827" CornerRadius="12" Padding="20" BorderBrush="#1F2937" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Install Directory -->
                    <TextBlock Text="O'rnatish katalogi:" FontSize="13" FontWeight="SemiBold" Foreground="#D1D5DB" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtInstallPath" Text="C:\SoftechClient" FontSize="13" Background="#1F2937" Foreground="White" BorderBrush="#374151" Padding="10,8" VerticalContentAlignment="Center"/>
                        <Button x:Name="BtnBrowse" Grid.Column="1" Content="📁 Tanlash" Margin="8,0,0,0" Style="{StaticResource OutlineButtonStyle}" Click="BtnBrowse_Click"/>
                    </Grid>

                    <!-- Network & Workstation Config -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Server WebSocket URL manzili:" FontSize="13" FontWeight="SemiBold" Foreground="#D1D5DB" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtServerUrl" Text="ws://192.168.199.105:5000/ws" FontSize="13" Background="#1F2937" Foreground="#6EE7B7" BorderBrush="#374151" Padding="10,8" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Stol Nomi:" FontSize="13" FontWeight="SemiBold" Foreground="#D1D5DB" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtWorkstationName" Text="PC-01" FontSize="13" FontWeight="Bold" Background="#1F2937" Foreground="#F59E0B" BorderBrush="#374151" Padding="10,8" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Options -->
                    <CheckBox x:Name="ChkDesktopShortcut" Content="Ish stolida 'Softech Client' yorlig'ini yaratish" IsChecked="True" Foreground="#E5E7EB" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkAutoStart" Content="Windows yoqilganda avtomatik ishga tushib, ekranni qulflasin (Tavsiya etiladi)" IsChecked="True" Foreground="#E5E7EB" Margin="0,0,0,14"/>

                    <!-- Safety Notice -->
                    <Border Background="#1E1E28" CornerRadius="8" Padding="12,10" BorderBrush="#4B5563" BorderThickness="1" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🛡️ Favqulodda Chiqish (Emergency Backdoor):" FontWeight="Bold" FontSize="12" Foreground="#FBBF24"/>
                            <TextBlock Text="Dastur qulflaganda chiqish: Ctrl + Shift + Alt + F12 bosing va 'Softech2026Master' parolini kiriting." FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Progress & Status -->
                    <ProgressBar x:Name="PbProgress" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="#10B981" Background="#1F2937" BorderThickness="0" Margin="0,4,0,6" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtStatus" Text="O'rnatishga tayyor. Kerakli stol raqamini kiritib, 'O'rnatish' tugmasini bosing." FontSize="12" Foreground="#9CA3AF"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer / Action Buttons -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="BtnStartClient" Content="🔒 Clientni Hozir Ishga Tushirish" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,10,0" Visibility="Collapsed" Click="BtnStartClient_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnInstall" Content="🚀 O'RNATISH VA SOZLASH" Style="{StaticResource NeonButtonStyle}" Margin="0,0,10,0" Click="BtnInstall_Click"/>
                <Button x:Name="BtnClose" Content="Chiqish" Style="{StaticResource OutlineButtonStyle}" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
