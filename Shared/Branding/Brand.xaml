<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Same geometry, colour and bundled font as website/softech/dist/assets/mark.svg.
         Use a vector inside windows; app.ico is only for Windows shortcuts/taskbars. -->
    <DrawingImage x:Key="SoftechMark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H40 V40 H0 Z" />
                <GeometryDrawing Brush="#C8FF31" Geometry="M13 3h22l-5 8H15l-3 5h15l6 8-8 13H3l5-8h15l3-5H11l-6-8z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <FontFamily x:Key="SoftechWordmarkFont">./Fonts/#Manrope</FontFamily>
    <Style x:Key="SoftechWordmark" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SoftechWordmarkFont}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="#F1F2F0" />
        <Setter Property="Text" Value="SOFTECH" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
