<Window x:Class="NetCafeClient.TimeWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeWidget"
        Width="350" MinHeight="150" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Modern Logout Button Template -->
        <ControlTemplate x:Key="LogoutButtonTemplate" TargetType="{x:Type Button}">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#E11D48"/>
                    <Setter TargetName="border" Property="BorderBrush" Value="#FB7185"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#BE123C"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Border Background="#18181B" CornerRadius="16" BorderBrush="#38BDF8" BorderThickness="1.5" Padding="14,10" Opacity="0.96">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.65" Direction="270" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Yuqori qator: PC raqami, Mijoz ismi va Balans -->
            <DockPanel Grid.Row="0" LastChildFill="True">
                <!-- Chap taraf: PC va Ism -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPc" Text="PC #1" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtMemberName" Text="Mehmon" FontSize="11" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                </StackPanel>

                <!-- O'ng taraf: Balans -->
                <TextBlock x:Name="TxtBalance" Text="" Visibility="Collapsed" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#34D399" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- 2. O'rta qator: Qolgan vaqt hisoblagichi -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,4">
                <TextBlock x:Name="TxtTimeLabel" Text="Qolgan vaqt: " FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtRemainingTime" Text="00:00:00" FontSize="24" FontWeight="ExtraBold" FontFamily="Consolas" Foreground="#F8FAFC" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="TxtSessionInterval" Grid.Row="2" Foreground="#CBD5E1" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <!-- Only authenticated self-service members may close their session. -->
            <DockPanel Grid.Row="3">
                <TextBlock x:Name="TxtTariff" Text="Mijoz Balansi" FontSize="10" Foreground="#71717A" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <Button x:Name="BtnLogout"
                        Visibility="Collapsed"
                        Content="Seansni yakunlash"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="#9F1239"
                        BorderBrush="#F43F5E"
                        BorderThickness="1"
                        Padding="10,3"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right"
                        Cursor="Hand"
                        Template="{StaticResource LogoutButtonTemplate}"
                        Click="BtnLogout_Click"/>
            </DockPanel>
            <TextBlock x:Name="TxtBillingStatus" Grid.Row="4" Foreground="#A1A1AA" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>
            <Button x:Name="BtnAccount" Grid.Row="5" Content="Mening hisobim: Login / parol" Visibility="Collapsed" Margin="0,8,0,0" Padding="8,5" Click="BtnAccount_Click"/>
        </Grid>
    </Border>
</Window>
