<Window x:Class="NetCafeClient.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NetCafeClient.Controls"
        xmlns:models="clr-namespace:NetCafeClient.Models"
        Title="Softech Game Club Shell"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#09090B"
        FontFamily="Segoe UI, Inter, Arial"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Cyber Neon Glow Brushes -->
        <SolidColorBrush x:Key="BgDark" Color="#09090B"/>
        <SolidColorBrush x:Key="CardBg" Color="#121215"/>
        <SolidColorBrush x:Key="BorderDark" Color="#27272A"/>
        <SolidColorBrush x:Key="CyanNeon" Color="#00F0FF"/>
        <SolidColorBrush x:Key="PurpleNeon" Color="#A855F7"/>
        <SolidColorBrush x:Key="EmeraldNeon" Color="#10B981"/>
        <SolidColorBrush x:Key="RoseNeon" Color="#F43F5E"/>
        <SolidColorBrush x:Key="AmberNeon" Color="#F59E0B"/>

        <!-- Custom Dark ScrollBar -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#27272A" CornerRadius="4" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category Tab Button Style -->
        <Style x:Key="CategoryTabStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="tabBorder"
                                Background="#18181B"
                                BorderBrush="#27272A"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}"
                                Margin="4,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#00F0FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0369A1" Offset="0"/>
                                            <GradientStop Color="#0284C7" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="tabBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#0284C7" BlurRadius="14" Opacity="0.5" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top Bar Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Grid -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Yuqori Panel (Top Bar) -->
            <RowDefinition Height="74"/>
            <!-- 2. Navigatsiya va Qidiruv Qatori -->
            <RowDefinition Height="64"/>
            <!-- 3. O'yinlar To'ri (Games Grid) -->
            <RowDefinition Height="*"/>
            <!-- 4. Pastki Status Panel -->
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- 1. YUQORI PANEL (TOP BAR) -->
        <!-- ================================================================= -->
        <Border Grid.Row="0" Background="#0C0D12" BorderBrush="#1E2028" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Chap Taraf: Logotip, PC badge, Foydalanuvchi ma'lumoti -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Klub Logotipi -->
                    <Border Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="16" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="SOFTECH" FontSize="14" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text=" ARENA" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Kompyuter Raqami ("PC-07") -->
                    <Border x:Name="PcBadge" Background="#164E63" BorderBrush="#06B6D4" BorderThickness="1.5" CornerRadius="8" Padding="10,4" Margin="0,0,14,0">
                        <TextBlock x:Name="TxtPcNumber" Text="PC-07" FontSize="13" FontWeight="Black" FontFamily="Consolas" Foreground="#00F0FF"/>
                    </Border>

                    <!-- Mijoz Ismi va Balansi -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCustomerName" Text="👤 Rustam (Mijoz)" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock x:Name="TxtCustomerBalance" Text="💳 45,000 UZS" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas" Foreground="#34D399"/>
                    </StackPanel>
                </StackPanel>

                <!-- O'rta Taraf: Katta Jonli Qolgan Vaqt Taymeri (Neon Monospaced) -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⏱️ " FontSize="18" Foreground="#00F0FF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtRemainingTime"
                                   Text="02:45:18"
                                   FontSize="32"
                                   FontWeight="Black"
                                   FontFamily="Consolas"
                                   Foreground="#00F0FF"
                                   VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#00F0FF" BlurRadius="20" Opacity="0.75" ShadowDepth="0"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock x:Name="TxtTariffName" Text="STANDART TARIF • QOLGAN VAQT" FontSize="9" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                </StackPanel>

                <!-- O'ng Taraf: [🛒 Bar], [🔔 Admin], [🔊 Ovoz], [✕ Qulf] -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Bardan buyurtma berish -->
                    <Button x:Name="BtnOpenBar"
                            Content="🛒 Bardan buyurtma"
                            Background="#1E293B"
                            BorderBrush="#38BDF8"
                            BorderThickness="1"
                            Foreground="#38BDF8"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0,0,8,0"
                            Click="BtnOpenBar_Click"/>

                    <!-- Adminni chaqirish -->
                    <Button x:Name="BtnCallAdmin"
                            Content="🔔 Adminni chaqirish"
                            Background="#291E0A"
                            BorderBrush="#F59E0B"
                            BorderThickness="1"
                            Foreground="#FBBF24"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0,0,8,0"
                            Click="BtnCallAdmin_Click"/>

                    <!-- Ovoz sozlash -->
                    <Button x:Name="BtnVolume"
                            Content="🔊 Ovoz"
                            Background="#241432"
                            BorderBrush="#C084FC"
                            BorderThickness="1"
                            Foreground="#E879F9"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0,0,8,0"
                            Click="BtnVolume_Click"/>

                    <!-- Seansni tugatish (Qulf) -->
                    <Button x:Name="BtnEndSession"
                            Content="✕ Chiqish"
                            Background="#4C0519"
                            BorderBrush="#F43F5E"
                            BorderThickness="1"
                            Foreground="#FDA4AF"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="BtnEndSession_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- 2. KATEGORIYALAR NAVIGATSIYASI VA QIDIRUV -->
        <!-- ================================================================= -->
        <Border Grid.Row="1" Background="#0E0F15" BorderBrush="#18181B" BorderThickness="0,0,0,1" Padding="28,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Kategoriya Tablari -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="🎮 Barchasi" Style="{StaticResource CategoryTabStyle}" IsChecked="True" Checked="CategoryTab_Checked" Tag="ALL"/>
                    <RadioButton Content="🎯 Otishma (Shooters)" Style="{StaticResource CategoryTabStyle}" Checked="CategoryTab_Checked" Tag="SHOOTER"/>
                    <RadioButton Content="⚔️ MOBA / Strategiya" Style="{StaticResource CategoryTabStyle}" Checked="CategoryTab_Checked" Tag="MOBA"/>
                    <RadioButton Content="🏎️ Sport &amp; Poyga" Style="{StaticResource CategoryTabStyle}" Checked="CategoryTab_Checked" Tag="SPORT"/>
                    <RadioButton Content="🌐 Ilovalar &amp; Brauzerlar" Style="{StaticResource CategoryTabStyle}" Checked="CategoryTab_Checked" Tag="APPS"/>
                </StackPanel>

                <!-- Qidiruv Maydoni (Search Input) -->
                <Border Grid.Column="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="18" Padding="12,6" Width="260">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="13" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtSearch"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontSize="13"
                                 VerticalAlignment="Center"
                                 TextChanged="TxtSearch_TextChanged"/>
                        <TextBlock Text="O'yin qidirish..."
                                   Grid.Column="1"
                                   IsHitTestVisible="False"
                                   Foreground="#52525B"
                                   FontSize="13"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- 3. O'YINLAR TO'RI (VIRTUALIZING GAME GRID - 60 FPS) -->
        <!-- ================================================================= -->
        <ScrollViewer Grid.Row="2"
                      x:Name="GamesScrollViewer"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="True"
                      Padding="28,24">
            <ItemsControl x:Name="GamesItemsControl">
                <!-- VirtualizingWrapPanel orqali 100+ o'yinlar 60 FPS silliq ko'rsatiladi -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:VirtualizingWrapPanel ItemWidth="230" ItemHeight="330"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:GameItem}">
                        <!-- O'yin Kartochkasi (Console Grade Card) -->
                        <Border x:Name="CardBorder"
                                Margin="10"
                                Background="#121217"
                                BorderBrush="#27272A"
                                BorderThickness="1.5"
                                CornerRadius="16"
                                SnapsToDevicePixels="True"
                                Cursor="Hand">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="CardTranslate" Y="0"/>
                            </Border.RenderTransform>

                            <Border.Effect>
                                <DropShadowEffect x:Name="CardShadow" BlurRadius="12" Color="#000000" Opacity="0.5" Direction="270" ShadowDepth="4"/>
                            </Border.Effect>

                            <Grid ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <!-- 3:4 Vertikal Poster Qismi -->
                                    <RowDefinition Height="200"/>
                                    <!-- Matn va Boshqaruv Qismi -->
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 1. Vertikal Poster Fon va Rassomlik (Artwork) -->
                                <Border Grid.Row="0" CornerRadius="15,15,0,0" ClipToBounds="True">
                                    <Grid>
                                        <!-- Gradient Artwork Fon -->
                                        <Border>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="{Binding GradientStart}" Offset="0"/>
                                                    <GradientStop Color="{Binding GradientEnd}" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- Neon Cyber Pattern / Markaziy Glif -->
                                        <TextBlock Text="{Binding IconGlyph}"
                                                   FontSize="64"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.85">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="{Binding AccentColor}" BlurRadius="24" Opacity="0.6" ShadowDepth="0"/>
                                            </TextBlock.Effect>
                                        </TextBlock>

                                        <!-- Agar rasm bo'lsa (Cover Art Poster) -->
                                        <Image Source="{Binding PosterPath}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasPosterImage, Converter={StaticResource BoolToVis}}"/>

                                        <!-- Yuqori Badge (HOT, TOP 1, YANGI) -->
                                        <Border Background="{Binding BadgeColor}"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="12"
                                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Black" Foreground="White"/>
                                        </Border>

                                        <!-- Janr nishoni (Chap yuqorida) -->
                                        <Border Background="#90000000" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12">
                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="#CBD5E1"/>
                                        </Border>

                                        <!-- Reyting (Chap pastda) -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,8">
                                            <TextBlock Text="★ " FontSize="11" Foreground="#FBBF24"/>
                                            <TextBlock Text="{Binding Rating, StringFormat='{}{0:F1}'}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 2. Kartochkaning pastki ma'lumot qismi -->
                                <Border Grid.Row="1" Background="#16171E" CornerRadius="0,0,15,15" Padding="14,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- O'yin nomi -->
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding Title}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Hoverda chiquvchi o'ynalgan soatlar yoki tavsif -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,8">
                                            <TextBlock Text="🎮 O'ynalgan: " FontSize="11" Foreground="#71717A"/>
                                            <TextBlock Text="{Binding PlayTimeHours}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                        </StackPanel>

                                        <!-- [O'YNASH] Tugmasi -->
                                        <Button Grid.Row="2"
                                                Tag="{Binding}"
                                                Click="BtnPlayGame_Click"
                                                Cursor="Hand"
                                                Height="34"
                                                VerticalAlignment="Bottom">
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border x:Name="btnBorder"
                                                            CornerRadius="8"
                                                            SnapsToDevicePixels="True">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#0284C7" Offset="0"/>
                                                                <GradientStop Color="#2563EB" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="▶ " FontSize="11" FontWeight="Black" Foreground="White"/>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="btnBorder" Property="Background">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                        <GradientStop Color="#00F0FF" Offset="0"/>
                                                                        <GradientStop Color="#3B82F6" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter TargetName="btnBorder" Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#00F0FF" BlurRadius="12" Opacity="0.6" ShadowDepth="0"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Hover Visual Triggers (Karta biroz ko'tariladi, neon glow ochiladi) -->
                        <DataTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#00F0FF"/>
                                <Setter TargetName="CardBorder" Property="Margin" Value="10,4,10,16"/>
                                <Setter TargetName="CardBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00F0FF" BlurRadius="24" Opacity="0.55" Direction="270" ShadowDepth="6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ================================================================= -->
        <!-- 4. PASTKI STATUS VA XABARLAR PANELI -->
        <!-- ================================================================= -->
        <Border Grid.Row="3" Background="#0C0D12" BorderBrush="#18181B" BorderThickness="0,1,0,0" Padding="28,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Chap taraf: Server Aloqasi Holati -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtServerStatus" Text="Server aloqasi faol • 60 FPS Engine" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>

                <!-- Markaz: Jonli ko'rsatma yoki e'lon -->
                <TextBlock Grid.Column="1"
                           x:Name="TxtClubNotice"
                           Text="🎮 O'yin boshlanganda launcher avtomatik orqa fonga o'tadi va tugagach qaytadi"
                           FontSize="11"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- O'ng taraf: Versiya -->
                <TextBlock Grid.Column="2" Text="SOFTECH CLIENT KIOSK v2.4" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#475569" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- 5. MODAL 1: BARDAN BUYURTMA BERISH (SNACK BAR MODAL) -->
        <!-- ================================================================= -->
        <Grid x:Name="BarModalOverlay" Grid.RowSpan="4" Background="#AA000000" Visibility="Collapsed">
            <Border Background="#121217"
                    BorderBrush="#38BDF8"
                    BorderThickness="1.5"
                    CornerRadius="20"
                    Width="680"
                    MaxHeight="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="36" Opacity="0.85" ShadowDepth="12"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Modal Sarlavhasi -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="🛒 Club Snack &amp; Bar" FontSize="20" FontWeight="Black" Foreground="White"/>
                            <TextBlock Text="O'rningizdan turmasdan buyurtma bering — xodim olib keladi" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Content="✕"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="#94A3B8"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                HorizontalAlignment="Right"
                                Click="BtnCloseBarModal_Click"/>
                    </DockPanel>

                    <!-- Mahsulotlar Ro'yxati -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="400">
                        <ItemsControl x:Name="SnacksItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SnackItem}">
                                    <Border Background="#181820" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Margin="0,4" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Emoji Icon -->
                                            <TextBlock Grid.Column="0" Text="{Binding IconEmoji}" FontSize="24" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                            <!-- Nomi va Narxi -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="{Binding Price, StringFormat='{}{0:N0} UZS'}" FontSize="12" Foreground="#38BDF8" FontFamily="Consolas"/>
                                            </StackPanel>

                                            <!-- Quantity Controls [-] [qty] [+] -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <Button Content="-" Width="28" Height="28" Background="#27272A" Foreground="White" Tag="{Binding}" Click="BtnMinusSnack_Click" Cursor="Hand"/>
                                                <TextBlock Text="{Binding OrderQuantity}" Width="32" TextAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                <Button Content="+" Width="28" Height="28" Background="#0284C7" Foreground="White" Tag="{Binding}" Click="BtnPlusSnack_Click" Cursor="Hand"/>
                                            </StackPanel>

                                            <!-- Jami Summa -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding TotalCost, StringFormat='{}{0:N0} UZS'}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       FontFamily="Consolas"
                                                       Foreground="#34D399"
                                                       VerticalAlignment="Center"
                                                       MinWidth="90"
                                                       TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Modal Pastki Qismi: Jami va Buyurtma Tugmasi -->
                    <Border Grid.Row="2" Background="#16171F" CornerRadius="12" Margin="0,16,0,0" Padding="16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="JAMI BUYURTMA:" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock x:Name="TxtBarTotalSum" Text="0 UZS" FontSize="18" FontWeight="Black" FontFamily="Consolas" Foreground="#34D399"/>
                            </StackPanel>

                            <Button x:Name="BtnSubmitBarOrder"
                                    DockPanel.Dock="Right"
                                    Content="✓ Buyurtmani Tasdiqlash"
                                    Background="#059669"
                                    BorderBrush="#10B981"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Padding="18,10"
                                    Cursor="Hand"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="BtnSubmitBarOrder_Click"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- 6. MODAL 2: OVOZ SOZLASH (VOLUME CONTROL POPOVER) -->
        <!-- ================================================================= -->
        <Grid x:Name="VolumeModalOverlay" Grid.RowSpan="4" Background="#66000000" Visibility="Collapsed" MouseDown="VolumeOverlay_MouseDown">
            <Border Background="#181820"
                    BorderBrush="#A855F7"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Width="340"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,84,30,0"
                    Padding="18">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="🔊 Tizim Ovozi" FontSize="14" FontWeight="Bold" Foreground="White" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="TxtVolumePercent" Text="75%" FontSize="14" FontWeight="Bold" Foreground="#E879F9" FontFamily="Consolas" DockPanel.Dock="Right"/>
                    </DockPanel>

                    <!-- Slider -->
                    <Slider x:Name="VolumeSlider"
                            Minimum="0"
                            Maximum="100"
                            Value="75"
                            TickFrequency="5"
                            IsSnapToTickEnabled="True"
                            ValueChanged="VolumeSlider_ValueChanged"
                            Margin="0,0,0,16"/>

                    <!-- Tezkor tugmalar: Mute, 30%, 70%, 100% -->
                    <UniformGrid Columns="4">
                        <Button Content="🔇 Mute" Background="#27272A" Foreground="White" Margin="2" Click="BtnVolumePreset_Click" Tag="0"/>
                        <Button Content="🔉 30%" Background="#27272A" Foreground="White" Margin="2" Click="BtnVolumePreset_Click" Tag="30"/>
                        <Button Content="🔊 70%" Background="#27272A" Foreground="White" Margin="2" Click="BtnVolumePreset_Click" Tag="70"/>
                        <Button Content="📢 100%" Background="#27272A" Foreground="White" Margin="2" Click="BtnVolumePreset_Click" Tag="100"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- 7. TOAST NOTIFICATION BANNER (Bildirishnomalar) -->
        <!-- ================================================================= -->
        <Border x:Name="ToastBanner"
                Grid.Row="0"
                Grid.RowSpan="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,88,0,0"
                Background="#0284C7"
                BorderBrush="#38BDF8"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20,12"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#0284C7" BlurRadius="20" Opacity="0.8" ShadowDepth="0"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastIcon" Text="🔔 " FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToastMessage" Text="Xabar matni" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
