<Window x:Class="NetCafeClient.Views.MaintenanceToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Maintenance Toolbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border Background="#F00F111A"
            BorderBrush="#F59E0B"
            BorderThickness="1.5"
            CornerRadius="12"
            Padding="14,8"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.8" ShadowDepth="4"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Pulsing Status Indicator -->
            <Border Width="10" Height="10" CornerRadius="5" Background="#F59E0B" Margin="0,0,10,0"/>

            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="TEXNIK XIZMAT REJIMI" FontSize="11" FontWeight="Black" Foreground="#F59E0B"/>
                <TextBlock x:Name="TxtPcStatus" Text="PC-01 | Qulf vaqtinchalik ochiq" FontSize="9" Foreground="#94A3B8"/>
            </StackPanel>

            <!-- Re-lock Button -->
            <Button x:Name="BtnRelock" Content="🔒 Qulflash"
                    Click="BtnRelock_Click"
                    Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1"
                    Padding="10,4" Margin="0,0,8,0" Cursor="Hand" FontWeight="Bold" FontSize="11">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Admin Settings Button -->
            <Button x:Name="BtnSettings" Content="⚙️ Sozlamalar"
                    Click="BtnSettings_Click"
                    Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#475569" BorderThickness="1"
                    Padding="10,4" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold" FontSize="11">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Complete Exit Button -->
            <Button x:Name="BtnExit" Content="❌ Dasturdan Chiqish"
                    Click="BtnExit_Click"
                    Background="#3F1219" Foreground="#FB7185" BorderBrush="#E11D48" BorderThickness="1"
                    Padding="10,4" Cursor="Hand" FontWeight="Bold" FontSize="11">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Border>
</Window>
