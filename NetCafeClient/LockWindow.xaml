<Window x:Class="NetCafeClient.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Softech NetCafe Standby Lock"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#050507"
        Focusable="True">

    <Window.Resources>
        <!-- Modern Rounded Input Template -->
        <ControlTemplate x:Key="ModernTextBoxTemplate" TargetType="{x:Type TextBox}">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12"
                    SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              Margin="14,10,14,10"
                              VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#06B6D4"/>
                    <Setter TargetName="border" Property="Background" Value="#10141D"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern PasswordBox Template -->
        <ControlTemplate x:Key="ModernPasswordBoxTemplate" TargetType="{x:Type PasswordBox}">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12"
                    SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              Margin="14,10,14,10"
                              VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#06B6D4"/>
                    <Setter TargetName="border" Property="Background" Value="#10141D"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Cyber Action Button Template -->
        <ControlTemplate x:Key="CyberButtonTemplate" TargetType="{x:Type Button}">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#0891B2"/>
                    <Setter TargetName="border" Property="BorderBrush" Value="#22D3EE"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#0E7490"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Tab Switcher Button Template -->
        <ControlTemplate x:Key="TabButtonTemplate" TargetType="{x:Type Button}">
            <Border x:Name="tabBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}"/>
            </Border>
        </ControlTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- 1. DYNAMIC BACKGROUND LAYER (Wallpaper with Blur Effect) -->
        <Image x:Name="ImgWallpaper"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Opacity="0.25">
            <Image.Effect>
                <BlurEffect Radius="18" RenderingBias="Performance"/>
            </Image.Effect>
        </Image>

        <!-- Semi-transparent Dark Veil Overlay -->
        <Border Background="#DE050508"/>

        <!-- Futuristic Cyber Radial Glows -->
        <!-- Center Violet Ambient Glow -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="850" Height="850"
                CornerRadius="425"
                Opacity="0.14" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#8B5CF6" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="0.85"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Top-Left Cyan Ambient Glow -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Width="600" Height="600" Margin="-150,-150,0,0"
                CornerRadius="300"
                Opacity="0.12" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#06B6D4" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Bottom-Right Emerald Ambient Glow -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Width="550" Height="550" Margin="0,0,-120,-120"
                CornerRadius="275"
                Opacity="0.10" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#10B981" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- MAIN LAYOUT DOCKPANEL -->
        <DockPanel LastChildFill="True">

            <!-- 2. TOP STATUS BAR -->
            <Border DockPanel.Dock="Top"
                    Height="80"
                    Background="#550D0E15"
                    BorderBrush="#252538"
                    BorderThickness="0,0,0,1"
                    Padding="28,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- CHAP: Klub Brendi va Server Holati -->
                    <StackPanel x:Name="LogoBrandPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="LogoBrandPanel_MouseLeftButtonDown">
                        <!-- Neon Cyber Icon -->
                        <Border Width="44" Height="44" CornerRadius="12" Background="#141724" BorderBrush="#06B6D4" BorderThickness="1.5" Margin="0,0,14,0">
                            <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#22D3EE"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SOFTECH" FontSize="16" FontWeight="Black" Foreground="White"/>
                                <TextBlock Text=" GAMING" FontSize="16" FontWeight="Black" Foreground="#06B6D4"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Border x:Name="PillServerStatus" Background="#122B1E" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="0,0,8,0">
                                    <TextBlock x:Name="TxtServerStatus" Text="● ONLINE" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                </Border>
                                <TextBlock Text="ESPORTS MANAGEMENT" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- MARKAZ: Stol Raqami, Zona va Tarif -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Station Number Badge -->
                        <Border Background="#12131F" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="12" Padding="16,6" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="STATION: " FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtPcNumber" Text="PC-07" FontSize="18" FontWeight="Black" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Zone Badge -->
                        <Border x:Name="BorderZoneBadge" Background="#201335" BorderBrush="#A855F7" BorderThickness="1.5" CornerRadius="12" Padding="14,6" Margin="0,0,12,0">
                            <TextBlock x:Name="TxtZoneBadge" Text="[ VIP BOOTCAMP ]" FontSize="13" FontWeight="ExtraBold" Foreground="#C084FC" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Hourly Tariff Widget -->
                        <Border Background="#12131F" BorderBrush="#252538" BorderThickness="1" CornerRadius="12" Padding="14,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Tarif: " FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtTariffRate" Text="{Binding ActiveHourlyRateDisplay}" FontSize="13" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- O'NG: Jonli Soat, Sana va Til Tanlash -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Sana va Soat -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0">
                            <TextBlock x:Name="TxtClock" Text="17:45:00" FontSize="18" FontWeight="Black" FontFamily="Consolas, Segoe UI" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TxtDate" Text="22-Oktyabr, 2026" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                        </StackPanel>

                        <!-- Til Tanlash Switcher -->
                        <Border Background="#12131F" BorderBrush="#252538" BorderThickness="1" CornerRadius="10" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnLangUz" Content="UZ" Width="32" Height="28" FontSize="11" FontWeight="Bold" Foreground="#06B6D4" Background="#1D2436" BorderThickness="0" Template="{StaticResource TabButtonTemplate}" Click="BtnLang_Click" Cursor="Hand"/>
                                <Button x:Name="BtnLangRu" Content="RU" Width="32" Height="28" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Background="Transparent" BorderThickness="0" Template="{StaticResource TabButtonTemplate}" Click="BtnLang_Click" Cursor="Hand"/>
                                <Button x:Name="BtnLangEn" Content="EN" Width="32" Height="28" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Background="Transparent" BorderThickness="0" Template="{StaticResource TabButtonTemplate}" Click="BtnLang_Click" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. PASTKI STATUS PANELI -->
            <Border DockPanel.Dock="Bottom"
                    Height="54"
                    Background="#5508080C"
                    BorderBrush="#1F1F2E"
                    BorderThickness="0,1,0,0"
                    Padding="28,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ℹ️ " FontSize="12" Foreground="#38BDF8"/>
                        <TextBlock x:Name="TxtBottomHint" Text="Mehmon sifatida o'ynash uchun kassaga murojaat qiling yoki hisobingiz orqali kiring." FontSize="11" FontWeight="Medium" Foreground="#94A3B8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️ Softech Kiosk Guard v2.4 • Himoyalangan Ish Stoli" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. MARKAZIY SHISHA AUTENTIFIKATSIYA KARTASI (Member Auth Card) -->
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border x:Name="CardBorder"
                        Width="440"
                        Background="#CC0E1019"
                        BorderBrush="#2A2A3D"
                        BorderThickness="1.5"
                        CornerRadius="20"
                        Padding="30,26">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="50" Color="#000000" Opacity="0.8" Direction="270" ShadowDepth="12"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="CardTranslateTransform" X="0" Y="0"/>
                    </Border.RenderTransform>

                    <StackPanel>
                        <!-- Header: Mijoz Kirishi -->
                        <TextBlock x:Name="TxtAuthHeader" Text="Mijoz Kirishi" FontSize="20" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtAuthSubHeader" Text="Hisobingiz va balansingiz orqali erkin o'ynang" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,3,0,16"/>

                        <!-- TABS SWITCHER (Telefon / QR-Kod) -->
                        <Border Background="#090A0F" BorderBrush="#202230" BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Tab 1: Telefon Orqali -->
                                <Button x:Name="BtnTabPhone"
                                        Grid.Column="0"
                                        Height="36"
                                        Content="📱 Telefon orqali"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="#22D3EE"
                                        Background="#162032"
                                        BorderBrush="#0891B2"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Template="{StaticResource TabButtonTemplate}"
                                        Click="BtnTabPhone_Click"/>

                                <!-- Tab 2: Tezkor QR-Kod -->
                                <Button x:Name="BtnTabQr"
                                        Grid.Column="1"
                                        Height="36"
                                        Content="⚡ Tezkor QR-Kod"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#64748B"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Template="{StaticResource TabButtonTemplate}"
                                        Click="BtnTabQr_Click"/>
                            </Grid>
                        </Border>

                        <!-- TAB 1 CONTENT: TELEFON VA PAROL ORQALI KIRISH -->
                        <StackPanel x:Name="PanelPhoneLogin" Visibility="Visible">
                            <!-- Telefon Raqami -->
                            <TextBlock x:Name="LblPhone" Text="Telefon raqami (+998)" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtPhone"
                                     Height="42"
                                     Background="#08090D"
                                     Foreground="White"
                                     BorderBrush="#252538"
                                     BorderThickness="1.5"
                                     FontSize="14"
                                     FontFamily="Consolas, Segoe UI"
                                     FontWeight="SemiBold"
                                     Text="+998 "
                                     Template="{StaticResource ModernTextBoxTemplate}"
                                     PreviewTextInput="TxtPhone_PreviewTextInput"
                                     PreviewKeyDown="TxtPhone_PreviewKeyDown"
                                     Margin="0,0,0,14"/>

                            <!-- Parol va Ko'rsatish/Yashirish (Eye Toggle) -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock x:Name="LblPassword" Text="Parol" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <!-- Yashirin Parol (PasswordBox) -->
                                <PasswordBox x:Name="TxtPassword"
                                             Height="42"
                                             Background="#08090D"
                                             Foreground="White"
                                             BorderBrush="#252538"
                                             BorderThickness="1.5"
                                             FontSize="15"
                                             Padding="12,0,45,0"
                                             Template="{StaticResource ModernPasswordBoxTemplate}"
                                             KeyDown="TxtPassword_KeyDown"
                                             PasswordChanged="TxtPassword_PasswordChanged"/>

                                <!-- Ochiq Parol (TextBox - Eye bosilganda) -->
                                <TextBox x:Name="TxtPasswordPlain"
                                         Height="42"
                                         Background="#08090D"
                                         Foreground="White"
                                         BorderBrush="#252538"
                                         BorderThickness="1.5"
                                         FontSize="14"
                                         Padding="12,0,45,0"
                                         Visibility="Collapsed"
                                         Template="{StaticResource ModernTextBoxTemplate}"
                                         KeyDown="TxtPasswordPlain_KeyDown"
                                         TextChanged="TxtPasswordPlain_TextChanged"/>

                                <!-- Ko'z belgisi tugmasi (Eye Toggle Button) -->
                                <Button x:Name="BtnTogglePassword"
                                        Width="38" Height="36"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,3,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Content="👁️"
                                        FontSize="14"
                                        Cursor="Hand"
                                        Click="BtnTogglePassword_Click"
                                        Template="{StaticResource TabButtonTemplate}"/>
                            </Grid>

                            <!-- XATOLIK BANNERI (Animated Shake) -->
                            <Border x:Name="BorderError"
                                    Background="#2E1218"
                                    BorderBrush="#F43F5E"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,8"
                                    Visibility="Collapsed"
                                    Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠️ " FontSize="13" Foreground="#FB7185" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtError" Text="Parol yoki telefon raqami xato kiritildi!" FontSize="11" FontWeight="SemiBold" Foreground="#FB7185" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- ASOSIY CTA TUGMASI (KIRISH) -->
                            <Button x:Name="BtnLogin"
                                    Height="46"
                                    Content="🚀 KIRISH / SEANS BOSHLASH"
                                    FontSize="13"
                                    FontWeight="Black"
                                    Foreground="White"
                                    Background="#0891B2"
                                    BorderBrush="#22D3EE"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Template="{StaticResource CyberButtonTemplate}"
                                    Click="BtnLogin_Click"
                                    Margin="0,0,0,14"/>
                        </StackPanel>

                        <!-- TAB 2 CONTENT: TEZKOR QR-KOD ORQALI KIRISH -->
                        <StackPanel x:Name="PanelQrLogin" Visibility="Collapsed" HorizontalAlignment="Center">
                            <TextBlock Text="Softech Mobile ilovasi orqali skanerlang" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Kamerani oching va darhol seansni boshlang" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                            <!-- QR Code Container (216x216 White High-Contrast Card) -->
                            <Border Width="216" Height="216"
                                    Background="White"
                                    BorderBrush="#38BDF8"
                                    BorderThickness="2"
                                    CornerRadius="16"
                                    Padding="8"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" Color="#06B6D4" Opacity="0.4" Direction="270" ShadowDepth="4"/>
                                </Border.Effect>
                                <Image x:Name="ImgQrCode"
                                       Width="200" Height="200"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       SnapsToDevicePixels="True"/>
                            </Border>

                            <!-- Token va Yangilanish Taymeri -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <TextBlock x:Name="TxtQrToken" Text="Token: SF-9812-PC07" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock x:Name="TxtQrTimer" Text="⏳ 45s" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Qo'lda yangilash tugmasi -->
                            <Button x:Name="BtnRefreshQr"
                                    Height="34"
                                    Width="180"
                                    Content="🔄 Yangi QR-Kod olish"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#38BDF8"
                                    Background="#141E2E"
                                    BorderBrush="#253952"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Template="{StaticResource CyberButtonTemplate}"
                                    Click="BtnRefreshQr_Click"
                                    Margin="0,0,0,14"/>
                        </StackPanel>

                        <!-- Card Footer Hint -->
                        <Border Background="#090A0F" BorderBrush="#1C1E2B" BorderThickness="1" CornerRadius="10" Padding="12,8">
                            <TextBlock x:Name="TxtCardHint" Text="💡 Balansingiz yetarlimi? Hisobingizdan daqiqama-daqiqa yechib boriladi." FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>

        <!-- 7. ADMIN MAINTENANCE & CONFIGURATION MODAL (Yashirin Admin Menyusi) -->
        <Grid x:Name="AdminModalOverlay" Background="#EA020205" Visibility="Collapsed">
            <Border Background="#12131D"
                    BorderBrush="#F59E0B"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Width="500"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="26">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.9" ShadowDepth="8"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,18">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#261A05" BorderBrush="#F59E0B" BorderThickness="1" Margin="0,0,12,0">
                                <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="ADMIN REJIMI VA SOZLAMALAR" FontSize="14" FontWeight="Black" Foreground="#F59E0B"/>
                                <TextBlock Text="Kiosk boshqaruvi va favqulodda chiqish" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Width="30" Height="30" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" Click="BtnCloseAdminModal_Click">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                        </Button>
                    </DockPanel>

                    <!-- STEP 1: AUTHENTICATION PANEL -->
                    <StackPanel x:Name="AdminAuthStepPanel">
                        <TextBlock Text="Admin / Menejer paroli:" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,8"/>
                        <PasswordBox x:Name="TxtAdminPassword"
                                     Height="46"
                                     FontSize="14"
                                     Foreground="White"
                                     Background="#0B0C12"
                                     BorderBrush="#334155"
                                     BorderThickness="1.5"
                                     Template="{StaticResource ModernPasswordBoxTemplate}"
                                     KeyDown="TxtAdminPassword_KeyDown"
                                     Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtAdminAuthError" Text="Noto'g'ri parol!" FontSize="11" Foreground="#F43F5E" Visibility="Collapsed" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Bekor qilish" Width="110" Height="38" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnCloseAdminModal_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button Content="Kirish" Width="110" Height="38" Background="#F59E0B" Foreground="#0B0C12" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnAdminAuthSubmit_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- STEP 2: DASHBOARD & CONFIGURATION PANEL -->
                    <StackPanel x:Name="AdminDashboardStepPanel" Visibility="Collapsed">
                        <!-- Quick Actions Grid -->
                        <TextBlock Text="TEZKOR AMALLAR:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Maintenance Unlock Button -->
                            <Button Grid.Column="0" Height="68" Background="#172554" BorderBrush="#3B82F6" BorderThickness="1.5" Cursor="Hand" Click="BtnAdminUnlockMaintenance_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🛠️ Texnik Rejim" FontSize="13" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Qulfni vaqtincha ochish" FontSize="10" Foreground="#93C5FD" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- Close / Exit Client Button -->
                            <Button Grid.Column="2" Height="68" Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1.5" Cursor="Hand" Click="BtnAdminExitClient_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="❌ Dasturdan Chiqish" FontSize="13" FontWeight="Bold" Foreground="#F87171" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Kioski to'liq to'xtatish" FontSize="10" Foreground="#FCA5A5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Config Section -->
                        <Border Background="#0B0C12" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="KIOSK SOZLAMALARI (CONFIG.JSON)" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Kompyuter raqami:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtConfigPcNumber" Grid.Column="1" Height="34" Background="#151722" Foreground="White" BorderBrush="#334155" BorderThickness="1" Padding="8,4" FontSize="12" FontWeight="Bold" Template="{StaticResource ModernTextBoxTemplate}"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Server WebSocket:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtConfigServerUrl" Grid.Column="1" Height="34" Background="#151722" Foreground="White" BorderBrush="#334155" BorderThickness="1" Padding="8,4" FontSize="11" FontFamily="Consolas" Template="{StaticResource ModernTextBoxTemplate}"/>
                                </Grid>

                                <DockPanel LastChildFill="False">
                                    <TextBlock x:Name="TxtConfigSaveMsg" DockPanel.Dock="Left" Text="✓ Saqlandi!" FontSize="11" Foreground="#10B981" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <Button DockPanel.Dock="Right" Content="💾 Saqlash va Qayta Ulanish" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11" Padding="12,6" Cursor="Hand" Click="BtnSaveConfig_Click">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Button Content="Yopish va Qulflash" Height="36" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" Click="BtnCloseAdminModal_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
